{
  "name": "dsh-restart-app",
  "version": "0.1.0",
  "description": "Sidebar button that restarts the whole DeepSeek Harness desktop app (Electron shell and Host) and reloads the page once it is back.",
  "type": "module",
  "license": "MIT",
  "author": "7AAAAAH",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7AAAAAH/dsh-restart-app.git"
  },
  "bugs": {
    "url": "https://github.com/7AAAAAH/dsh-restart-app/issues"
  },
  "homepage": "https://github.com/7AAAAAH/dsh-restart-app#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "electron",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./scripts": "./scripts.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "scripts.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node test/render.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
